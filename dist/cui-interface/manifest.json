{
  "manifest_version": 3,
  "name": "SIS Studio",
  "version": "1.4.1",
  "description": "Customize COMSATS Lahore SIS with refined layouts, light and dark themes, clearer tables, and a more useful student dashboard.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://lhr-sis.comsats.edu.pk/*",
    "https://uuqpvolvuwaisqriemeq.supabase.co/*",
    "https://sfs.cuilahore.edu.pk/*"
  ],
  "background": {
    "service_worker": "companion-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lhr-sis.comsats.edu.pk/*"],
      "css": ["ui/styles/tokens.css", "ui/styles/portal.css", "ui/styles/features.css"],
      "js": ["ui/adapter.js", "ui/parsers.js", "ui/preferences.js", "ui/controls.js", "ui/features.js", "ui/academic.js", "ui/companion-data.js", "ui/timetable.js", "ui/companion-style.js", "ui/companion.js", "ui/main.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SIS Studio - Open COMSATS SIS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
